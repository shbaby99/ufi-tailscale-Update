        }

        const userInfo = await getUserInfo()
        const running = await isTailscaledRunning()

        if (statusTextEl) {
            if (running) statusTextEl.textContent = '运行中'
            else if (userInfo.isLoggedIn) statusTextEl.textContent = '已停止'
            else statusTextEl.textContent = '未登录'
