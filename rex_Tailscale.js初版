        if (!installed) {
            if (statusTextEl) statusTextEl.textContent = '未安装'
            if (statusDotEl) { statusDotEl.style.background = '#888'; statusDotEl.style.boxShadow = 'none' }
            if (ipEl) ipEl.textContent = '-'
            if (versionEl) versionEl.textContent = '-'
